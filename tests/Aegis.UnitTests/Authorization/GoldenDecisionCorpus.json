      "expectedReasonCode": "DENY_EXPLICIT"
    },
    {
      "id": "no-match-fails-closed",
      "tenantId": "tenant-a",
      "subject": "user:carol",
      "relation": "editor",
      "object": "document:plan",
      "relationships": [],
      "expectedAllowed": false,
      "expectedReasonCode": "DENY_NOT_FOUND"
    },
    {
      "id": "tenant-isolation",
      "tenantId": "tenant-b",
      "subject": "user:alice",
      "relation": "viewer",
      "object": "document:plan",
      "relationships": [
        {
          "tenantId": "tenant-a",
          "subject": "user:alice",
          "relation": "viewer",
          "object": "document:plan",
          "effect": "allow"
        }
      ],
      "expectedAllowed": false,
