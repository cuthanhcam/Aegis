      "model": "type document\n  define viewer: viewer from parent\ntype folder\n  define viewer: this",
      "relationships": [
        {
          "tenantId": "tenant-a",
          "subject": "folder:root",
          "relation": "parent",
          "object": "document:plan",
          "effect": "allow"
        },
        {
          "tenantId": "tenant-a",
          "subject": "user:dana",
          "relation": "viewer",
          "object": "folder:root",
          "effect": "allow"
