{
  "Storage": {
    "Provider": "Postgres"
  },
  "Cache": {
    "Provider": "Memory",
    "DecisionTtlSeconds": 15,
    "Redis": {
      "Configuration": "localhost:6379"
    }
  },
  "Jwt": {
    "Issuer": "Aegis",
    "Audience": "Aegis.Client",
    "Secret": "",
    "AccessTokenMinutes": 60,
    "RefreshTokenDays": 7,
    "MaxActiveRefreshSessionsPerUser": 5,
    "RefreshSessionRetentionDays": 30
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5173",
      "http://localhost:3000"
    ]
  },
  "ConnectionStrings": {
    "Aegis": ""
  },
  "Auth": {
    "DemoUsers": []
  },
  "Outbox": {
    "BatchSize": 100,
    "PollIntervalSeconds": 10
  },
  "Seed": {
    "Development": {
      "Enabled": false
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AuthorizationEngine": {
    "MaxDepth": 8
  },
  "AllowedHosts": "*"
}
